    "Sign in to iCloud to share with your team. Local editing and PDF export are available offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Local editing and PDF export are available offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Lokales Bearbeiten und PDF-Export funktionieren offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos. La edición local y la exportación PDF funcionan sin conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva. Modifica locale ed esportazione PDF funzionano offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. A edição local e a exportação PDF funcionam offline."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε ένα αρχείο ή στείλε αντίγραφο απευθείας. Οι αλλαγές μένουν στη συσκευή μέχρι την επόμενη κοινοποίηση. Η τοπική επεξεργασία και η εξαγωγή PDF λειτουργούν εκτός σύνδεσης."
          }
        }
      },
      "extractionState": "manual"
    },
