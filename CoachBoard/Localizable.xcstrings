    "Close the passing lane together. Recover into shape when the ball moves.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the passing lane together. Recover into shape when the ball moves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt gemeinsam den Passweg. Rückt nach der Ballbewegung wieder in die Grundordnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrad juntos la línea de pase. Recuperad la posición cuando se mueva el balón."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudete insieme la linea di passaggio. Ritrovate la posizione quando si muove la palla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechem juntos a linha de passe. Retomem a formação quando a bola se mover."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλείστε μαζί τη γραμμή πάσας. Επιστρέψτε στη διάταξη όταν κινηθεί η μπάλα."
          }
        }
      },
      "extractionState": "manual"
    },
    "Cloud sharing is unavailable. Check your iCloud account and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud sharing is unavailable. Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos. Revisa tu cuenta e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva. Controlla il tuo account e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. Confira sua conta e tente novamente."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε ένα αρχείο ή στείλε αντίγραφο απευθείας. Οι αλλαγές μένουν στη συσκευή μέχρι την επόμενη κοινοποίηση. Ελέγξτε τον λογαριασμό σας και δοκιμάστε ξανά."
          }
        }
      },
      "extractionState": "manual"
    },
