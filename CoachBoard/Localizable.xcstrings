    "Your iCloud tactics and invitations were removed. Local copies are unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Local copies are unchanged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Lokale Kopien bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos. Las copias locales no cambian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva. Le copie locali restano invariate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. As cópias locais permanecem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε ένα αρχείο ή στείλε αντίγραφο απευθείας. Οι αλλαγές μένουν στη συσκευή μέχρι την επόμενη κοινοποίηση. Τα τοπικά αντίγραφα παραμένουν."
          }
        }
      },
      "extractionState": "manual"
    },
    "Your latest tactic and training plan, saved on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest tactic and training plan, saved on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte Taktik und dein Trainingsplan, lokal gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu última táctica y tu plan, guardados en este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima tattica e piano allenamenti salvati su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua última tática e seu plano salvos neste aparelho."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τελευταία τακτική και το πλάνο, αποθηκευμένα στη συσκευή."
          }
        }
      },
      "extractionState": "manual"
    },
