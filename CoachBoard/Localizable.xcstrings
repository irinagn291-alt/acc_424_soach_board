    "Receive a reminder one day before training, or one hour before a session planned at short notice. Team updates are announced after you sync.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive a reminder one day before training, or one hour before a session planned at short notice. Team updates are announced after you sync."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine Erinnerung einen Tag vor dem Training oder eine Stunde bei kurzfristiger Planung. Team-Neuigkeiten erscheinen nach der Synchronisierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso un día antes del entrenamiento, o una hora antes si lo planificas a última hora. Los cambios del equipo se avisan al sincronizar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un promemoria un giorno prima o un'ora prima per sessioni pianificate all'ultimo. Gli aggiornamenti di squadra vengono segnalati dopo la sincronizzazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba um lembrete um dia antes do treino, ou uma hora antes quando planejado em cima da hora. Atualizações da equipe são avisadas após sincronizar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάβετε υπενθύμιση μία μέρα πριν, ή μία ώρα πριν για προπόνηση τελευταίας στιγμής. Οι ενημερώσεις ομάδας εμφανίζονται μετά τον συγχρονισμό."
          }
        }
      },
      "extractionState": "manual"
    },
    "Redo": {
      "localizations": {
