    "For help, use the support details for this app on its App Store page. You can report an app problem through Apple Support.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For help, use the support details for this app on its App Store page. You can report an app problem through Apple Support."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfe findest du über die Supportangaben auf der App Store-Seite. Probleme kannst du dem Apple Support melden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para obtener ayuda, consulta los datos de soporte en la página de la app en App Store. Puedes informar de problemas a Soporte de Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per assistenza consulta i recapiti nella pagina App Store. Puoi segnalare problemi tramite il supporto Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para obter ajuda, consulte o suporte na página do app na App Store. Você pode relatar problemas ao Suporte da Apple."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για βοήθεια δείτε τα στοιχεία υποστήριξης στη σελίδα App Store. Αναφέρετε προβλήματα στην Υποστήριξη Apple."
          }
        }
      },
      "extractionState": "manual"
    },
