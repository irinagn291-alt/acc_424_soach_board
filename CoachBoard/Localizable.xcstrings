    "Built-in exercises are starting points. Adapt the movements and intensity to your players.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in exercises are starting points. Adapt the movements and intensity to your players."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die integrierten Übungen sind Ausgangspunkte. Passe Bewegungen und Intensität an dein Team an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ejercicios incluidos son puntos de partida. Adapta los movimientos y la intensidad a tus jugadores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli esercizi inclusi sono punti di partenza. Adatta movimenti e intensità ai tuoi giocatori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os exercícios incluídos são pontos de partida. Adapte os movimentos e a intensidade aos seus jogadores."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ενσωματωμένες ασκήσεις είναι αφετηρίες. Προσαρμόστε κινήσεις και ένταση στους παίκτες σας."
          }
        }
      },
      "extractionState": "manual"
    },
