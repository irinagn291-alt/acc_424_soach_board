    "A shared playbook. A clear plan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shared playbook. A clear plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsame Taktik. Klarer Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tácticas compartidas. Un plan claro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tattiche condivise. Un piano chiaro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Táticas em equipe. Um plano claro."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοινές τακτικές. Ξεκάθαρο πλάνο."
          }
        }
      },
      "extractionState": "manual"
    },
    "A tactic can contain up to 24 frames.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tactic can contain up to 24 frames."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Taktik kann bis zu 24 Bilder enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una táctica admite hasta 24 fotogramas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tattica può contenere fino a 24 fotogrammi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tática pode ter até 24 quadros."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια τακτική μπορεί να έχει έως 24 καρέ."
          }
        }
      },
      "extractionState": "manual"
    },
    "Add Soach Board widgets to your Home Screen or Lock Screen. They use the last saved local board and training plan, with no network requests.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Soach Board widgets to your Home Screen or Lock Screen. They use the last saved local board and training plan, with no network requests."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Soach Board-Widgets zum Home- oder Sperrbildschirm hinzu. Sie zeigen die zuletzt lokal gespeicherte Tafel und den Trainingsplan ohne Netzabfragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade widgets de Soach Board a la pantalla de inicio o de bloqueo. Muestran la última pizarra y el plan guardados en el dispositivo, sin acceder a la red."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i widget di Soach Board alla schermata Home o di blocco. Usano la lavagna e il piano salvati sul dispositivo, senza richieste di rete."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione widgets do Soach Board à Tela de Início ou Bloqueada. Eles usam o quadro e o plano salvos no aparelho, sem acesso à rede."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε widget του Soach Board στην οθόνη αφετηρίας ή κλειδώματος. Χρησιμοποιούν τον τοπικά αποθηκευμένο πίνακα και το πρόγραμμα, χωρίς δίκτυο."
          }
        }
      },
      "extractionState": "manual"
    },
    "Add a session, attach tactics and repeat it across your season.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a session, attach tactics and repeat it across your season."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein Training, verknüpfe Taktiken und wiederhole es über die Saison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una sesión, adjunta tácticas y repítela durante la temporada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una sessione, associa le tattiche e ripetila durante la stagione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um treino, inclua táticas e repita ao longo da temporada."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε προπόνηση, συνδέστε τακτικές και επαναλάβετε στη σεζόν."
          }
        }
      },
      "extractionState": "manual"
    },
