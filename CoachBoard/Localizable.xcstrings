    "Invite specific teammates to a read-only tactic. They can duplicate it to create their own version. No public feed or app account is used.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite specific teammates to a read-only tactic. They can duplicate it to create their own version. No public feed or app account is used."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade einzelne Teammitglieder zu einer schreibgeschützten Taktik ein. Sie können eine eigene Kopie erstellen. Es gibt keinen öffentlichen Feed und kein App-Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a compañeros concretos a ver una táctica. Pueden duplicarla para crear su versión. No hay muro público ni cuenta de la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita compagni specifici a una tattica in sola lettura. Possono duplicarla per creare la propria versione. Nessun feed pubblico o account dell'app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convide colegas específicos para ver uma tática. Eles podem duplicá-la para criar sua versão. Não há feed público nem conta do app."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσκαλέστε συγκεκριμένους συμπαίκτες σε τακτική μόνο για ανάγνωση. Μπορούν να την αντιγράψουν. Δεν υπάρχει δημόσια ροή ή λογαριασμός εφαρμογής."
          }
        }
      },
      "extractionState": "manual"
    },
    "It will also be removed from local training plans. iCloud invitations are managed in Team & settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will also be removed from local training plans. Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wird auch aus lokalen Trainingsplänen entfernt. Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se eliminará de los planes locales. Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà rimossa anche dai piani locali. Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela também será removida dos planos locais. Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα αφαιρεθεί και από τα τοπικά πλάνα. Άνοιξε ένα αρχείο ή στείλε αντίγραφο απευθείας. Οι αλλαγές μένουν στη συσκευή μέχρι την επόμενη κοινοποίηση."
          }
        }
      },
      "extractionState": "manual"
    },
